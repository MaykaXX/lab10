@startuml task2_factory_method
title Завдання 2. Квитки для різних каналів продажу (Factory Method)
skinparam classAttributeIconSize 0

abstract class SalesChannel <<Creator>> {
  - soldCount : int
  + sell(screening : Screening, seat : String, price : int) : Ticket
  + {abstract} getName() : String
  # {abstract} createTicket(screening : Screening, seat : String,\n price : int) : Ticket
  + getSoldCount() : int
  - reserveSeat(seat : String) : void
  - acceptPayment(price : int) : void
  - recordSale(seat : String) : void
}

class CashierChannel <<ConcreteCreator>> {
  + getName() : String
  # createTicket(screening : Screening, seat : String,\n price : int) : Ticket
}
class WebsiteChannel <<ConcreteCreator>> {
  + getName() : String
  # createTicket(screening : Screening, seat : String,\n price : int) : Ticket
}
class AppChannel <<ConcreteCreator>> {
  + getName() : String
  # createTicket(screening : Screening, seat : String,\n price : int) : Ticket
}
class SelfServiceChannel <<ConcreteCreator>> {
  + getName() : String
  # createTicket(screening : Screening, seat : String,\n price : int) : Ticket
}

interface Ticket <<Product>> {
  + describe() : String
}

class PaperTicket <<ConcreteProduct>> {
  - screening : Screening
  - seat : String
  - price : int
  + PaperTicket(screening : Screening, seat : String, price : int)
  + describe() : String
}
class PdfTicket <<ConcreteProduct>> {
  - screening : Screening
  - seat : String
  - price : int
  - qrCode : String
  + PdfTicket(screening : Screening, seat : String, price : int)
  + describe() : String
}
class WalletTicket <<ConcreteProduct>> {
  - screening : Screening
  - seat : String
  - price : int
  + WalletTicket(screening : Screening, seat : String, price : int)
  + describe() : String
}
class TerminalTicket <<ConcreteProduct>> {
  - screening : Screening
  - seat : String
  - price : int
  + TerminalTicket(screening : Screening, seat : String, price : int)
  + describe() : String
}

class Screening <<Value object>> {
  - film : String
  - hall : int
  - start : LocalDateTime
  + toString() : String
}

class Logger <<Utility>> {
  + {static} log(source : String, event : String) : void
}

class Main <<Client>> {
  ~ {static} task2FactoryMethod() : void
}

note right of SalesChannel
  Процес продажу описано один раз у sell():
  резервування → оплата → createTicket() →
  видача → запис продажу.
  Розгалужень за каналом немає.
end note

note bottom of SelfServiceChannel
  Підключено новими класами
  (SelfServiceChannel, TerminalTicket).
  SalesChannel не змінювався.
end note

SalesChannel <|-- CashierChannel
SalesChannel <|-- WebsiteChannel
SalesChannel <|-- AppChannel
SalesChannel <|-- SelfServiceChannel

Ticket <|.. PaperTicket
Ticket <|.. PdfTicket
Ticket <|.. WalletTicket
Ticket <|.. TerminalTicket

SalesChannel ..> Ticket : <<use>>\ncreateTicket()
CashierChannel ..> PaperTicket : <<create>>
WebsiteChannel ..> PdfTicket : <<create>>
AppChannel ..> WalletTicket : <<create>>
SelfServiceChannel ..> TerminalTicket : <<create>>

SalesChannel ..> Screening : <<use>>
SalesChannel ..> Logger : <<use>>
PaperTicket --> "1" Screening
PdfTicket --> "1" Screening
WalletTicket --> "1" Screening
TerminalTicket --> "1" Screening

Main ..> SalesChannel : sell()
Main ..> CashierChannel
Main ..> WebsiteChannel
Main ..> AppChannel
Main ..> SelfServiceChannel
@enduml