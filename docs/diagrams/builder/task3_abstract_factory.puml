@startuml task3_abstract_factory
title Завдання 3. Налаштування залу під формат показу (Abstract Factory)
skinparam classAttributeIconSize 0
skinparam nodesep 12
skinparam ranksep 55

class Main <<Client>> {
  ~ {static} task3AbstractFactory() : void
}

class SessionLauncher <<Client>> {
  - {static} SRC : String
  + launch(hall : int, film : String,\n factory : HallEquipmentFactory) : void
}

class Logger <<Utility>> {
  + {static} log(source : String, event : String) : void
}

interface FilmCopy <<AbstractProduct A>> {
  + getFormat() : String
  + describe() : String
}
interface ProjectorProfile <<AbstractProduct B>> {
  + getFormat() : String
  + describe() : String
}
interface SoundProfile <<AbstractProduct C>> {
  + getFormat() : String
  + describe() : String
}

class Copy2D <<ConcreteProduct A>> {
  - film : String
  + Copy2D(film : String)
}
class Projector2D <<ConcreteProduct B>>
class Sound2D <<ConcreteProduct C>>

class Copy3D <<ConcreteProduct A>> {
  - film : String
  + Copy3D(film : String)
}
class Projector3D <<ConcreteProduct B>>
class Sound3D <<ConcreteProduct C>>

class CopyAtmos <<ConcreteProduct A>> {
  - film : String
  + CopyAtmos(film : String)
}
class ProjectorAtmos <<ConcreteProduct B>>
class SoundAtmos <<ConcreteProduct C>>

class CopyImax <<ConcreteProduct A>> {
  - film : String
  + CopyImax(film : String)
}
class ProjectorImax <<ConcreteProduct B>>
class SoundImax <<ConcreteProduct C>>

class Hall2DFactory <<ConcreteFactory>>
class Hall3DFactory <<ConcreteFactory>>
class HallAtmosFactory <<ConcreteFactory>>
class HallImaxFactory <<ConcreteFactory>>

interface HallEquipmentFactory <<AbstractFactory>> {
  + getFormat() : String
  + createFilmCopy(film : String) : FilmCopy
  + createProjectorProfile() : ProjectorProfile
  + createSoundProfile() : SoundProfile
}

note right of SessionLauncher
  Працює лише з інтерфейсами,
  конкретних класів не знає.
  Новий формат (IMAX) додається
  новою фабрикою, без змін тут.
end note

note right of HallImaxFactory
  Формат додано пізніше,
  SessionLauncher не змінювався.
end note

note right of Main
  Main створює конкретні фабрики
  і передає їх у launch().
end note

' --- рівні ---
Main -[hidden]down-> SessionLauncher
SessionLauncher -[hidden]right-> Logger
FilmCopy -[hidden]right- ProjectorProfile
ProjectorProfile -[hidden]right- SoundProfile
SessionLauncher -[hidden]down-> ProjectorProfile

' --- клієнт ---
Main ..> SessionLauncher : launch()
SessionLauncher ..> FilmCopy : <<use>>
SessionLauncher ..> ProjectorProfile : <<use>>
SessionLauncher ..> SoundProfile : <<use>>
SessionLauncher ..> Logger : <<use>>

' --- реалізація продуктів ---
FilmCopy <|.. Copy2D
FilmCopy <|.. Copy3D
FilmCopy <|.. CopyAtmos
FilmCopy <|.. CopyImax
ProjectorProfile <|.. Projector2D
ProjectorProfile <|.. Projector3D
ProjectorProfile <|.. ProjectorAtmos
ProjectorProfile <|.. ProjectorImax
SoundProfile <|.. Sound2D
SoundProfile <|.. Sound3D
SoundProfile <|.. SoundAtmos
SoundProfile <|.. SoundImax

' --- фабрики створюють продукти свого формату ---
Copy2D <.. Hall2DFactory : <<create>>
Projector2D <.. Hall2DFactory : <<create>>
Sound2D <.. Hall2DFactory : <<create>>
Copy3D <.. Hall3DFactory : <<create>>
Projector3D <.. Hall3DFactory : <<create>>
Sound3D <.. Hall3DFactory : <<create>>
CopyAtmos <.. HallAtmosFactory : <<create>>
ProjectorAtmos <.. HallAtmosFactory : <<create>>
SoundAtmos <.. HallAtmosFactory : <<create>>
CopyImax <.. HallImaxFactory : <<create>>
ProjectorImax <.. HallImaxFactory : <<create>>
SoundImax <.. HallImaxFactory : <<create>>

' --- реалізація фабрики ---
Hall2DFactory ..|> HallEquipmentFactory
Hall3DFactory ..|> HallEquipmentFactory
HallAtmosFactory ..|> HallEquipmentFactory
HallImaxFactory ..|> HallEquipmentFactory
SessionLauncher ..> HallEquipmentFactory : <<use>>
@enduml